# Raw dataset files (gitignored due to size)
data/raw/
*.csv

# Exceptions: Keep subsample and golden dataset files
!data/subsample/*.json
!data/golden/*.csv
!data/golden/*.json
!data/*.json

# Environment variables & API keys
.env
*.env

# Python & IDE cache
__pycache__/
*.pyc
.venv/
venv/
.idea/
.vscode/
.DS_Store
